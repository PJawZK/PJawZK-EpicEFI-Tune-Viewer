{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epicefi.example/schemas/tune-metadata.schema.json",
  "title": "EpicEFI Tune Viewer published tune metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "validationStatus", "classification", "ecuTarget", "firmwareSignature"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "ecuTarget": { "type": "string", "minLength": 1 },
    "firmwareSignature": { "type": "string", "minLength": 1 },
    "validationStatus": {
      "enum": [
        "Unverified",
        "Starts/Idles",
        "Driven",
        "Road Tested",
        "Performance Tested",
        "Track Tested",
        "Dyno Tested",
        "EpicEFI Verified"
      ]
    },
    "classification": {
      "enum": ["Normal", "Experimental", "Base Tune", "Development"]
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  }
}
