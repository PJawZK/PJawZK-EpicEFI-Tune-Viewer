{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pjawzk.github.io/PJawZK-EpicEFI-Tune-Viewer/schemas/tune-metadata.schema.json",
  "title": "EpicEFI Tune Viewer published tune metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "author",
    "publishedAt",
    "ecuTarget",
    "firmwareSignature",
    "validationStatus",
    "classification",
    "tags",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 96
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "publishedAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "ecuTarget": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "firmwareSignature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "validationStatus": {
      "description": "EpicEFI Verified is reserved and also requires a matching repository authority entry.",
      "enum": [
        "Unverified",
        "Starts/Idles",
        "Driven",
        "Road Tested",
        "Performance Tested",
        "Track Tested",
        "Dyno Tested",
        "EpicEFI Verified"
      ]
    },
    "classification": {
      "enum": [
        "Normal",
        "Experimental",
        "Base Tune",
        "Development"
      ]
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "make": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "year": {
          "type": "number"
        },
        "trim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "make": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "displacementLiters": {
          "type": "number"
        },
        "cylinders": {
          "type": "number"
        },
        "aspiration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "compressionRatio": {
          "type": "number"
        }
      }
    },
    "fuel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "ignition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "injectorCc": {
      "type": "number"
    },
    "powerHp": {
      "type": "number"
    },
    "stockPowerHp": {
      "type": "number"
    },
    "torqueNm": {
      "type": "number"
    },
    "boostBar": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "versionLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "parentTuneId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 96
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "msq"
      ],
      "properties": {
        "msq": {
          "const": "tune.msq"
        },
        "ini": {
          "const": "mainController.ini"
        }
      }
    },
    "lifecycleStatus": {
      "description": "Absent means actively published. Archived tunes remain addressable but are excluded from normal discovery.",
      "enum": [
        "Archived"
      ]
    },
    "archivedAt": {
      "type": "string",
      "minLength": 1
    },
    "archiveReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
